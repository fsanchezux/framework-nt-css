{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "framework-nt-css theme",
  "type": "object",
  "required": [
    "id",
    "name",
    "colors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scheme": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canvas": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Fondo de página — Detrás de todo el contenido."
        },
        "sidebar": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Barra lateral / navbar — Fondo de la navegación principal."
        },
        "paper": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Tarjetas y paneles — Cards, menús, diálogos, inputs."
        },
        "ink": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Texto y líneas — Se usa con opacidad (ink/45, ink/[.08]) para jerarquía y bordes."
        },
        "muted": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Texto secundario — Descripciones y metadatos."
        },
        "accent": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Acento — Botón principal, pestaña activa, selección."
        },
        "accent-strong": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Acento (hover) — Estado hover/pressed del acento."
        },
        "accent-soft": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Acento suave — Iconos, menciones, cifras destacadas."
        },
        "on-accent": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Texto sobre acento — Texto encima de un fondo de acento."
        },
        "success": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Éxito"
        },
        "warning": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Aviso"
        },
        "danger": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Error / peligro"
        },
        "glow-base": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Base del degradado — Color de arriba del fondo de marca."
        },
        "glow-deep": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Fondo del degradado — Color de abajo antes del brillo."
        },
        "glow": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Brillo — Luz de color que enciende el fondo."
        }
      }
    },
    "font": {
      "type": "string",
      "description": "CSS font-family"
    },
    "radius": {
      "type": "string"
    }
  }
}
